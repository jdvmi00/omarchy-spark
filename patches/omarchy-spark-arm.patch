diff --git i/install/config/firewall.sh w/install/config/firewall.sh
index de38943..e1fa118 100644
--- i/install/config/firewall.sh
+++ w/install/config/firewall.sh
@@ -10,6 +10,19 @@ ufw allow 53317/tcp
 ufw allow in proto udp from 172.16.0.0/12 to 172.17.0.1 port 53 comment 'allow-docker-dns'
 ufw allow in proto udp from 192.168.0.0/16 to 172.17.0.1 port 53 comment 'allow-docker-dns'
 
+# A machine that is administered or discovered over the network must stay
+# reachable after the firewall turns on. Only services already enabled here
+# get a rule: SSH, mDNS for the avahi hostname, and the Tailscale interface.
+if systemctl is-enabled --quiet sshd.service 2>/dev/null; then
+  ufw allow in 22/tcp comment 'allow-ssh'
+fi
+if systemctl is-enabled --quiet avahi-daemon.service 2>/dev/null; then
+  ufw allow in 5353/udp comment 'allow-mdns'
+fi
+if systemctl is-enabled --quiet tailscaled.service 2>/dev/null; then
+  ufw allow in on tailscale0 comment 'allow-tailscale'
+fi
+
 # Turn on Docker protections. ufw-docker refuses to install its after.rules
 # block unless UFW is already active, but during ISO finalization the target
 # chroot shares the live installer's kernel firewall. Keep the live firewall
diff --git i/install/config/snapper.sh w/install/config/snapper.sh
index 3e936ec..c0e753a 100644
--- i/install/config/snapper.sh
+++ w/install/config/snapper.sh
@@ -1,3 +1,10 @@
+# Snapshots need a Btrfs root and snapper. The ARM port's tested installation
+# is ext4 with GRUB, so this is a no-op there instead of a failed step.
+if [[ $(findmnt -no FSTYPE / 2>/dev/null) != "btrfs" ]] || ! command -v snapper >/dev/null 2>&1; then
+  echo "Skipping Snapper configuration: root is not Btrfs or snapper is not installed"
+  exit 0
+fi
+
 SNAPPER_CONFIG_PATH="${OMARCHY_SNAPPER_CONFIG_PATH:-/etc/snapper/configs/root}"
 SNAPPER_CONF_PATH="${OMARCHY_SNAPPER_CONF_PATH:-/etc/conf.d/snapper}"
 template="${OMARCHY_SNAPPER_TEMPLATE:-${OMARCHY_PATH:-/usr/share/omarchy}/default/snapper/root}"

diff --git i/install/post-install/pacman.sh w/install/post-install/pacman.sh
index da84975..c009159 100644
--- i/install/post-install/pacman.sh
+++ w/install/post-install/pacman.sh
@@ -1,7 +1,13 @@
 # Configure pacman after package installation completes. Offline target package
 # installs use the live ISO's offline pacman.conf until this final restore.
-cp -f "$OMARCHY_PATH/default/pacman/pacman-${OMARCHY_MIRROR:-stable}.conf" /etc/pacman.conf
-cp -f "$OMARCHY_PATH/default/pacman/mirrorlist-${OMARCHY_MIRROR:-stable}" /etc/pacman.d/mirrorlist
+# The ARM port uses the signed Arch Linux ARM repositories (see omarchy-refresh-pacman).
+if [[ $(uname -m) == "aarch64" ]]; then
+  cp -f "$OMARCHY_PATH/spark/pacman-aarch64.conf" /etc/pacman.conf
+  cp -f "$OMARCHY_PATH/spark/mirrorlist-aarch64" /etc/pacman.d/mirrorlist
+else
+  cp -f "$OMARCHY_PATH/default/pacman/pacman-${OMARCHY_MIRROR:-stable}.conf" /etc/pacman.conf
+  cp -f "$OMARCHY_PATH/default/pacman/mirrorlist-${OMARCHY_MIRROR:-stable}" /etc/pacman.d/mirrorlist
+fi
 
 # Wait for CUPS to own the file, the way omarchy-settings does, so pacman does
 # not turn the override into a .pacnew during ISO package installation.
diff --git i/spark/mirrorlist-aarch64 w/spark/mirrorlist-aarch64
new file mode 100644
index 0000000..5591fa4
--- /dev/null
+++ w/spark/mirrorlist-aarch64
@@ -0,0 +1,2 @@
+# Arch Linux ARM official mirror selector; package signatures are required.
+Server = http://mirror.archlinuxarm.org/$arch/$repo
diff --git i/spark/pacman-aarch64.conf w/spark/pacman-aarch64.conf
new file mode 100644
index 0000000..6f89058
--- /dev/null
+++ w/spark/pacman-aarch64.conf
@@ -0,0 +1,23 @@
+# Spark port: signed Arch Linux ARM repositories, without x86 multilib.
+[options]
+Color
+ILoveCandy
+VerbosePkgLists
+HoldPkg = pacman glibc
+Architecture = auto
+CheckSpace
+ParallelDownloads = 5
+DownloadUser = alpm
+SigLevel = Required DatabaseOptional
+LocalFileSigLevel = Optional
+
+[core]
+Include = /etc/pacman.d/mirrorlist
+[extra]
+Include = /etc/pacman.d/mirrorlist
+[alarm]
+Include = /etc/pacman.d/mirrorlist
+[aur]
+Include = /etc/pacman.d/mirrorlist
+[omarchy]
+Server = https://pkgs.omarchy.org/$arch

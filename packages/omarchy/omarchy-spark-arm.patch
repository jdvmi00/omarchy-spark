diff --git i/bin/omarchy-mise-install w/bin/omarchy-mise-install
index e6dfc96..63994ff 100755
--- i/bin/omarchy-mise-install
+++ w/bin/omarchy-mise-install
@@ -14,14 +14,10 @@ bin=${3:-$command}
 
 mkdir -p "$HOME/.local/bin"
 
-# These tools install and upgrade on first run, so mise's release cooldown would
-# hold a new version back for days after it ships. Exported rather than set on
-# the install line alone, so resolving the version to execute agrees with the
-# one just installed.
+# Let mise apply the user's configured release age when resolving and running tools.
 rm -f "$HOME/.local/bin/$command"
 cat >"$HOME/.local/bin/$command" <<EOF
 #!/bin/bash
-export MISE_MINIMUM_RELEASE_AGE=0
 mise use -g --quiet "$package" || exit 1
 exec mise x "$package" -- "$bin" "\$@"
 EOF
diff --git i/bin/omarchy-refresh-pacman w/bin/omarchy-refresh-pacman
index 299d6c2..774146d 100755
--- i/bin/omarchy-refresh-pacman
+++ w/bin/omarchy-refresh-pacman
@@ -3,21 +3,33 @@
 # omarchy:summary=Overwrite the package configuration for /etc/pacman with the Omarchy default of using its dedicated mirrors and repositories, then update all packages.
 # omarchy:requires-sudo=true
 
-sudo cp -f /etc/pacman.conf /etc/pacman.conf.bak
-sudo cp -f /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.bak
+set -e
 
 channel="${1:-stable}"
-
 if [[ $channel != "stable" && $channel != "rc" && $channel != "edge" ]]; then
   echo "Error: Invalid channel '$channel'. Must be one of: stable, rc, edge"
   exit 1
 fi
 
+if [[ $(uname -m) == "aarch64" ]]; then
+  if [[ $channel != "stable" ]]; then
+    echo "Error: This ARM port uses Arch Linux ARM repositories; rc and edge channels are unavailable."
+    exit 1
+  fi
+  pacman_config="$OMARCHY_PATH/spark/pacman-aarch64.conf"
+  mirrorlist="$OMARCHY_PATH/spark/mirrorlist-aarch64"
+else
+  pacman_config="$OMARCHY_PATH/default/pacman/pacman-$channel.conf"
+  mirrorlist="$OMARCHY_PATH/default/pacman/mirrorlist-$channel"
+fi
+
+[[ -r $pacman_config && -r $mirrorlist ]]
 echo "Setting channel to $channel"
 echo
-
-sudo cp -f "$OMARCHY_PATH/default/pacman/pacman-$channel.conf" /etc/pacman.conf
-sudo cp -f "$OMARCHY_PATH/default/pacman/mirrorlist-$channel" /etc/pacman.d/mirrorlist
+sudo cp -f /etc/pacman.conf /etc/pacman.conf.bak
+sudo cp -f /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.bak
+sudo cp -f "$pacman_config" /etc/pacman.conf
+sudo cp -f "$mirrorlist" /etc/pacman.d/mirrorlist
 
 # Allow user customization of /etc/pacman.conf before the upgrade runs
 omarchy-hook pre-refresh-pacman
diff --git i/install/config/firewall.sh w/install/config/firewall.sh
index de38943..e1fa118 100644
--- i/install/config/firewall.sh
+++ w/install/config/firewall.sh
@@ -10,6 +10,19 @@ ufw allow 53317/tcp
 ufw allow in proto udp from 172.16.0.0/12 to 172.17.0.1 port 53 comment 'allow-docker-dns'
 ufw allow in proto udp from 192.168.0.0/16 to 172.17.0.1 port 53 comment 'allow-docker-dns'
 
+# A machine that is administered or discovered over the network must stay
+# reachable after the firewall turns on. Only services already enabled here
+# get a rule: SSH, mDNS for the avahi hostname, and the Tailscale interface.
+if systemctl is-enabled --quiet sshd.service 2>/dev/null; then
+  ufw allow in 22/tcp comment 'allow-ssh'
+fi
+if systemctl is-enabled --quiet avahi-daemon.service 2>/dev/null; then
+  ufw allow in 5353/udp comment 'allow-mdns'
+fi
+if systemctl is-enabled --quiet tailscaled.service 2>/dev/null; then
+  ufw allow in on tailscale0 comment 'allow-tailscale'
+fi
+
 # Turn on Docker protections. ufw-docker refuses to install its after.rules
 # block unless UFW is already active, but during ISO finalization the target
 # chroot shares the live installer's kernel firewall. Keep the live firewall
diff --git i/install/config/snapper.sh w/install/config/snapper.sh
index 3e936ec..c0e753a 100644
--- i/install/config/snapper.sh
+++ w/install/config/snapper.sh
@@ -1,3 +1,10 @@
+# Snapshots need a Btrfs root and snapper. The ARM port's tested installation
+# is ext4 with GRUB, so this is a no-op there instead of a failed step.
+if [[ $(findmnt -no FSTYPE / 2>/dev/null) != "btrfs" ]] || ! command -v snapper >/dev/null 2>&1; then
+  echo "Skipping Snapper configuration: root is not Btrfs or snapper is not installed"
+  exit 0
+fi
+
 SNAPPER_CONFIG_PATH="${OMARCHY_SNAPPER_CONFIG_PATH:-/etc/snapper/configs/root}"
 SNAPPER_CONF_PATH="${OMARCHY_SNAPPER_CONF_PATH:-/etc/conf.d/snapper}"
 template="${OMARCHY_SNAPPER_TEMPLATE:-${OMARCHY_PATH:-/usr/share/omarchy}/default/snapper/root}"

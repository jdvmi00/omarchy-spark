#!/usr/bin/python3
"""Configure NVIDIA's native backend with Arch-managed dependencies, as the user."""
import argparse
import datetime
import getpass
import json
import os
from pathlib import Path
import shutil
import subprocess
import yaml

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--no-start', action='store_true', help='Enable the service without starting it yet')
args = parser.parse_args()
if os.geteuid() == 0:
    parser.error('Run as the desktop user, not root')
home = Path.home()
if home != Path('/home') / getpass.getuser():
    parser.error('This Spark service template requires a /home/<username> home directory')
base = home / '.nvwb'
config_file = base / 'config.yaml'
config = yaml.safe_load(config_file.read_text()) if config_file.exists() else {}
config = config or {}
if config.get('container', {}).get('runtime') not in (None, '', 'docker'):
    parser.error('Existing non-Docker runtime requires a deliberate migration')
groups = subprocess.check_output(['id', '-nG', getpass.getuser()], text=True).split()
if 'docker' not in groups:
    parser.error('Docker-group membership is required for the native backend')
subprocess.run(['/usr/bin/newgrp', 'docker', '-c', '/usr/bin/docker info >/dev/null'], check=True)
base.mkdir(mode=0o700, exist_ok=True)
backup = base / 'spark-backups' / datetime.datetime.now().strftime('%Y%m%dT%H%M%S%f')
backup.mkdir(parents=True, mode=0o700)
if config_file.exists():
    shutil.copy2(config_file, backup / 'config.yaml')
config.setdefault('container', {}).update(runtime='docker', buildtime='docker')
config.setdefault('service', {})['working_dir'] = str(base)
config_file.write_text(yaml.safe_dump(config))
config_file.chmod(0o600)
bindir = base / 'bin'
bindir.mkdir(exist_ok=True)
for name, target in {
    'nvwb-cli': '/usr/lib/nvwb-spark/nvwb-cli',
    'wb-svc': '/usr/lib/nvwb-spark/wb-svc',
    'credential-manager': '/opt/NVIDIA AI Workbench/resources/bin/credential-manager',
}.items():
    path = bindir / name
    if path.exists() or path.is_symlink():
        if path.is_symlink() and os.readlink(path) == target:
            continue
        shutil.copy2(path, backup / name, follow_symlinks=False)
        path.unlink()
    path.symlink_to(target)
cli = str(bindir / 'nvwb-cli')
contexts = subprocess.run([cli, 'list', 'contexts', '-o', 'json'], capture_output=True, text=True, check=True)
existing = json.loads(contexts.stdout).get('result', []) if contexts.stdout.strip() else []
local = next((c for c in existing if c['name'] == 'local'), None)
if local and (local['hostname'] != 'localhost' or local['workbenchDir'] != str(base)):
    parser.error('Existing local context points elsewhere; inspect it before migration')
if not local:
    subprocess.run([cli, 'create', 'context', 'local', 'localhost', '--context-workbench-dir', str(base), '--description', 'Native Arch ARM'], check=True)
for name in ('.bashrc', '.zshrc'):
    if (home / name).exists():
        shutil.copy2(home / name, backup / name)
subprocess.run([cli, 'internal', 'install-hook', getpass.getuser(), str(os.getuid()), str(os.getgid())], check=True)
unit = 'nvwb-spark@' + getpass.getuser() + '.service'
subprocess.run(['sudo', '-n', 'systemctl', 'daemon-reload'], check=True)
subprocess.run(['sudo', '-n', 'systemctl', 'enable', unit], check=True)
if not args.no_start:
    subprocess.run(['sudo', '-n', 'systemctl', 'start', unit], check=True)
print('Native Workbench configured; existing files backed up under', backup)

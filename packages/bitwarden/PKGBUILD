# Omarchy Spark: Bitwarden desktop from its official Linux arm64 release bundle;
# the AUR/Arch package is x86_64-only.
pkgname=bitwarden
pkgver=2026.8.0
pkgrel=1
pkgdesc="A secure and free password manager for all of your devices"
url="https://bitwarden.com"
license=('GPL-3.0-only')
arch=('aarch64')
depends=('gtk3' 'nss' 'libxss' 'libxtst' 'alsa-lib' 'at-spi2-core' 'libnotify' 'libsecret' 'libappindicator-gtk3' 'xdg-utils' 'hicolor-icon-theme')
options=('!strip')
source=("LICENSE_GPL-${pkgver}.txt::https://raw.githubusercontent.com/bitwarden/clients/desktop-v${pkgver}/LICENSE_GPL.txt")
source_aarch64=("bitwarden_${pkgver}_arm64.tar.gz::https://github.com/bitwarden/clients/releases/download/desktop-v${pkgver}/bitwarden_${pkgver}_arm64.tar.gz")
noextract=("bitwarden_${pkgver}_arm64.tar.gz")
sha256sums=('b98fbb37db5b23bc5cfdcd16793206a5a7120a7b01f75374e5e0888376e4691c')
sha256sums_aarch64=('5962b5dd1bfe19b3c198a6b4157c4431efe078e573217bffcaafa71147476ebe')

package() {
  install -dm755 "$pkgdir/opt/Bitwarden"
  bsdtar -xf "$srcdir/bitwarden_${pkgver}_arm64.tar.gz" -C "$pkgdir/opt/Bitwarden"
  chmod -R u+rwX,go+rX,go-w "$pkgdir/opt/Bitwarden"
  # The Spark kernel supports user namespaces; keep the normal Electron sandbox
  # and do not make chrome-sandbox setuid.
  chmod 0755 "$pkgdir/opt/Bitwarden/chrome-sandbox"
  install -dm755 "$pkgdir/usr/bin"
  ln -s /opt/Bitwarden/bitwarden "$pkgdir/usr/bin/bitwarden"
  install -Dm644 "$pkgdir/opt/Bitwarden/resources/com.bitwarden.desktop.desktop" \
    "$pkgdir/usr/share/applications/com.bitwarden.desktop.desktop"
  for size in 16 32 64 128 256 512 1024; do
    install -Dm644 "$pkgdir/opt/Bitwarden/resources/icons/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/com.bitwarden.desktop.png"
  done
  install -Dm644 "$srcdir/LICENSE_GPL-${pkgver}.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

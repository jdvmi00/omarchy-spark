# Maintainer: Caleb Maclennan <caleb@alerque.com>

pkgname=aquamarine-compat13
pkgver=0.14.0
pkgrel=1
pkgdesc='Aquamarine ABI 13 runtime for the current Arch ARM Hyprland packages'
arch=(x86_64 aarch64)
url="https://github.com/hyprwm/aquamarine"
license=(BSD-3-Clause)
depends=(libgcc
         libstdc++
         glibc # libc.so libm.so
         hyprutils libhyprutils.so
         hyprwayland-scanner
         libdisplay-info libdisplay-info.so
         libdrm # libdrm.so
         libglvnd libEGL.so
         libinput # libinput.so
         mesa # libgbm.so
         opengl-driver
         pixman
         seatd libseat.so
         systemd-libs libudev.so
         wayland libwayland-client.so
         wayland-protocols)
makedepends=(cmake)
provides=(libaquamarine.so)
_archive="aquamarine-$pkgver"
source=("$url/archive/v$pkgver/$_archive.tar.gz")
sha256sums=('5dcf0b17f7dd51539fd7e79d68484f04240b3b63cf9f5f21d5b6dea0088168f9')

build() {
	cd "$_archive"
	cmake -B build \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release
	cmake --build build --parallel "${BUILD_JOBS:-4}"
}

package() {
  cd "$_archive"
  DESTDIR="$srcdir/staged" cmake --install build
  install -dm755 "$pkgdir/usr/lib"
  # Only the versioned ABI 13 runtime. The current aquamarine package retains
  # ownership of headers, pkg-config metadata and the unversioned linker name.
  cp -a "$srcdir/staged/usr/lib/"libaquamarine.so.* "$pkgdir/usr/lib/"
  [[ -e "$pkgdir/usr/lib/libaquamarine.so.13" ]]
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

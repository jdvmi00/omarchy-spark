pkgbase = omarchy-settings
	pkgdesc = Omarchy user defaults, /etc/skel content, fonts, plymouth theme, and support helpers
	pkgver = 4.0.2
	pkgrel = 3
	url = https://github.com/basecamp/omarchy
	install = omarchy-settings.install
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = git
	makedepends = imagemagick
	depends = bash
	depends = curl
	depends = gum
	depends = hicolor-icon-theme
	depends = plymouth
	optdepends = omarchy: Full Omarchy desktop
	optdepends = inxi: System information for omarchy-debug
	optdepends = fastfetch: System information for omarchy-upload-log
	conflicts = omarchy-settings-dev
	backup = etc/fastfetch/config.jsonc
	backup = etc/docker/daemon.json
	backup = etc/gnupg/dirmngr.conf
	backup = etc/sysctl.d/99-omarchy-sysctl.conf
	backup = etc/sysctl.d/90-omarchy-file-watchers.conf
	backup = etc/systemd/logind.conf.d/10-ignore-power-button.conf
	backup = etc/systemd/logind.conf.d/20-inhibit-delay.conf
	backup = etc/systemd/resolved.conf.d/10-disable-multicast.conf
	backup = etc/systemd/resolved.conf.d/20-docker-dns.conf
	backup = etc/systemd/system.conf.d/10-faster-shutdown.conf
	backup = etc/systemd/system/user@.service.d/10-faster-shutdown.conf
	backup = etc/systemd/system/docker.service.d/no-block-boot.conf
	backup = etc/systemd/system/plocate-updatedb.service.d/ac-only.conf
	backup = etc/systemd/system.conf.d/20-omarchy-nofile.conf
	backup = etc/systemd/user.conf.d/20-omarchy-nofile.conf
	backup = etc/sddm.conf.d/10-theme.conf
	backup = etc/sddm.conf.d/10-wayland.conf
	backup = etc/mkinitcpio.conf.d/omarchy_hooks.conf
	backup = etc/mkinitcpio.conf.d/thunderbolt_module.conf
	backup = etc/limine-entry-tool.d/omarchy-defaults.conf
	backup = etc/limine-entry-tool.d/omarchy-uki.conf
	backup = etc/modprobe.d/omarchy-usb-autosuspend.conf
	backup = etc/systemd/oomd.conf.d/10-omarchy.conf
	backup = etc/systemd/zram-generator.conf
	source = omarchy::git+https://github.com/basecamp/omarchy.git#commit=346e69e1cec6c4e8924531874af6ba010a1bc99e
	sha256sums = ed1ca61045f73e313c3e73874d324945e2b5357e6510664eab25783b26138197
	optdepends_x86_64 = limine: Bootloader the shipped /etc/mkinitcpio.conf.d/ and /etc/limine-entry-tool.d/ drop-ins are for
	optdepends_x86_64 = limine-mkinitcpio-hook: Picks up the shipped /etc/mkinitcpio.conf.d/omarchy_hooks.conf
	optdepends_x86_64 = limine-snapper-sync: Boot-entry sync for snapper snapshots
	optdepends_x86_64 = zram-generator: Reads the shipped /etc/systemd/zram-generator.conf to create the compressed swap device
	optdepends_x86_64 = snapper: Used with the shipped /etc/snapper/config-templates/omarchy template

pkgname = omarchy-settings

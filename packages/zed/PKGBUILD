# Omarchy Spark: Zed from its official Linux aarch64 release bundle. Arch builds
# zed from source for x86_64; Arch Linux ARM does not build it, and Zed's own
# release includes a complete aarch64 bundle with its cli, editor and libraries.
pkgname=zed
pkgver=1.18.1
pkgrel=1
pkgdesc="A high-performance, multiplayer code editor from the creators of Atom and Tree-sitter"
url="https://zed.dev"
license=('GPL-3.0-or-later' 'AGPL-3.0-or-later' 'Apache-2.0')
arch=('aarch64')
depends=('gcc-libs' 'glibc' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'vulkan-icd-loader' 'alsa-lib' 'fontconfig' 'openssl' 'zlib' 'libx11' 'libxcb' 'hicolor-icon-theme')
optdepends=('nodejs: language server support' 'vulkan-driver: GPU rendering')
provides=('zed-editor')
conflicts=('zed-editor')
options=('!strip')
source=("LICENSE-GPL-${pkgver}::https://raw.githubusercontent.com/zed-industries/zed/v${pkgver}/LICENSE-GPL")
source_aarch64=("zed-${pkgver}-linux-aarch64.tar.gz::https://github.com/zed-industries/zed/releases/download/v${pkgver}/zed-linux-aarch64.tar.gz")
noextract=("zed-${pkgver}-linux-aarch64.tar.gz")
sha256sums=('0aa0322ea494da441088e4d9144c6720bf99d9e2e1eefcd29d1f58b19b5c4246')
sha256sums_aarch64=('7ee93bcd1059c4f0d700578ccfa00aebda5fc521c943fe3ffbf71aac41a081a7')

package() {
  # The bundle is a self-contained zed.app tree: bin/zed (cli), libexec/zed-editor,
  # its private libraries and share/ data. The cli finds the editor relative to
  # itself, so the tree is kept whole under /usr/lib/zed.
  install -dm755 "$pkgdir/usr/lib/$pkgname"
  bsdtar -xf "$srcdir/zed-${pkgver}-linux-aarch64.tar.gz" --strip-components=1 -C "$pkgdir/usr/lib/$pkgname"
  chmod -R u+rwX,go+rX,go-w "$pkgdir/usr/lib/$pkgname"
  install -dm755 "$pkgdir/usr/bin"
  ln -s "/usr/lib/$pkgname/bin/zed" "$pkgdir/usr/bin/zed"
  install -Dm644 "$pkgdir/usr/lib/$pkgname/share/applications/dev.zed.Zed.desktop" \
    "$pkgdir/usr/share/applications/dev.zed.Zed.desktop"
  cp -r "$pkgdir/usr/lib/$pkgname/share/icons" "$pkgdir/usr/share/"
  rm -rf "$pkgdir/usr/lib/$pkgname/share/applications" "$pkgdir/usr/lib/$pkgname/share/icons"
  install -Dm644 "$srcdir/LICENSE-GPL-${pkgver}" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-GPL"
}
